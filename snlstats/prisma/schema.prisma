generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CastMember {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  joinSeason  Int?
  leaveSeason Int?        // null means current cast member
  status      String   @default("Repertory")
  headshot    String?
  createdAt   DateTime @default(now())

  performances         CastPerformance[]
  sketchAppearances    SketchAppearance[]
  seasonStats          SeasonStats[]
  seasonCast           SeasonCast[]
  seasonMedia          SeasonCastMedia[]
  seasonLeaders        SeasonLeaders[]
  careerStats          CastMemberCareerStats?

  @@index([slug])
  @@index([status])
}

model Season {
  id          String   @id @default(cuid())
  seasonNumber Int     @unique
  yearStarted Int
  yearEnded   Int
  numEpisodes Int
  heroImageUrl String?
  navImageUrl String?
  createdAt   DateTime @default(now())

  episodes    Episode[]
  stats       SeasonStats[]
  castMembers SeasonCast[]
  castMedia   SeasonCastMedia[]
  leaders     SeasonLeaders[]

  @@index([seasonNumber])
}

model SeasonCast {
  id          String   @id @default(cuid())
  seasonId    String
  castMemberId String
  status      String   @default("repertory") 
  createdAt   DateTime @default(now())

  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  castMember  CastMember @relation(fields: [castMemberId], references: [id], onDelete: Cascade)

  @@unique([seasonId, castMemberId])
  @@index([seasonId])
  @@index([castMemberId])
}

model Episode {
  id            String   @id @default(cuid())
  seasonId      String
  episodeNumber Int
  airDate       DateTime
  host          String?
  musicalGuest  String?
  slug          String   @unique
  imageUrls     String[] @default([])
  createdAt     DateTime @default(now())

  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  performances  CastPerformance[]
  sketches      Sketch[]
  liveFromNewYork LiveFromNewYork? 

  @@unique([seasonId, episodeNumber])
  @@index([seasonId])
  @@index([airDate])
}

model CastPerformance {
  id                  String   @id @default(cuid())
  episodeId           String
  castMemberId        String
  screenTimeSeconds   Int
  sketchCount         Int
  powerRanking        Decimal  @db.Decimal(5, 2)
  status              String   @default("present")
  createdAt           DateTime @default(now())

  episode             Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  castMember          CastMember @relation(fields: [castMemberId], references: [id], onDelete: Cascade)

  @@unique([episodeId, castMemberId])
  @@index([episodeId])
  @@index([castMemberId])
}

model LiveFromNewYork {
  id              String   @id @default(cuid())
  episodeId       String   @unique
  castMemberIds   String[] @default([])
  createdAt       DateTime @default(now())

  episode         Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId])
}

model Sketch {
  id              String   @id @default(cuid())
  episodeId       String
  title           String
  sketchNumber    Int?
  durationSeconds Int?
  segmentType     String?
  createdAt       DateTime @default(now())

  episode         Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  appearances     SketchAppearance[]

  @@index([episodeId])
}

model SketchAppearance {
  id              String   @id @default(cuid())
  sketchId        String
  castMemberId    String
  role            String?
  createdAt       DateTime @default(now())

  sketch          Sketch   @relation(fields: [sketchId], references: [id], onDelete: Cascade)
  castMember      CastMember @relation(fields: [castMemberId], references: [id], onDelete: Cascade)

  @@unique([sketchId, castMemberId])
  @@index([sketchId])
  @@index([castMemberId])
}

model SeasonStats {
  id                       String   @id @default(cuid())
  seasonId                 String
  castMemberId             String
  
  totalScreenTimeSeconds   Int      @default(0)
  totalAppearances         Int      @default(0)
  episodesPresent          Int      @default(0)
  averageScreenTimeSeconds Decimal  @db.Decimal(8, 2)
  averageAppearances       Decimal  @db.Decimal(5, 2)
  powerRankingSeason       Decimal  @db.Decimal(5, 2)
  
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  season                   Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  castMember               CastMember @relation(fields: [castMemberId], references: [id], onDelete: Cascade)

  @@unique([seasonId, castMemberId])
  @@index([seasonId])
  @@index([castMemberId])
}

model SeasonCastMedia {
  id              String   @id @default(cuid())
  seasonId        String
  castMemberId    String
  imageUrl        String
  imageType       String   @default("season-opening")
  createdAt       DateTime @default(now())

  season          Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  castMember      CastMember @relation(fields: [castMemberId], references: [id], onDelete: Cascade)

  @@unique([seasonId, castMemberId, imageType])
  @@index([seasonId])
  @@index([castMemberId])
}

model SeasonLeaders {
  id              String   @id @default(cuid())
  seasonId        String
  castMemberId    String
  
  isScreenTimeLeader    Boolean @default(false)
  isSketchLeader        Boolean @default(false)
  isPowerRankingLeader  Boolean @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  season          Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  castMember      CastMember @relation(fields: [castMemberId], references: [id], onDelete: Cascade)
  
  @@unique([seasonId, castMemberId])
  @@index([seasonId])
  @@index([castMemberId])
}

model CastMemberCareerStats {
  id                       String   @id @default(cuid())
  castMemberId             String   @unique
  
  totalSeasons             Int      @default(0)
  totalEpisodes            Int      @default(0)
  totalScreenTimeSeconds   Int      @default(0)
  totalAppearances         Int      @default(0)
  averageScreenTimeSeconds Decimal  @db.Decimal(8, 2)
  averageAppearancesPerEp  Decimal  @db.Decimal(5, 2)
  averagePowerRanking      Decimal  @db.Decimal(5, 2)
  totalLiveFromNewYorks    Int      @default(0)
  yearJoined  Int?  // e.g., 2003
  yearLeft    Int?  // e.g., 2024, or null if current
  
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  
  castMember               CastMember @relation(fields: [castMemberId], references: [id], onDelete: Cascade)
  
  @@index([castMemberId])
}

// Add this model to your schema.prisma file

model UpcomingEpisode {
  id              String   @id @default(cuid())
  seasonNumber    Int
  episodeNumber   Int
  airDate         DateTime
  host            String
  musicalGuest    String
  announcedDate   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([seasonNumber, episodeNumber])
  @@index([airDate])
  @@index([announcedDate])
}
